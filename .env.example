DATABASE_URL=postgresql://crm:local-crm-only@127.0.0.1:55439/crm
APP_URL=http://127.0.0.1:3040
# Production email verification requires a verified Resend sender.
RESEND_API_KEY=
EMAIL_FROM=
# Development only: prints email verification codes to the local server console.
DEV_EMAIL_CONSOLE=true
AUTH_SECRET=replace-with-at-least-32-random-characters
# Protects the daily Vercel digest job. Generate a separate random secret.
CRON_SECRET=replace-with-a-separate-random-secret
